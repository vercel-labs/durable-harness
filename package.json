{
  "name": "durable-harness-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "check:changesets": "node --test scripts/check-changesets.test.mjs && node scripts/check-changesets.mjs",
    "ci:publish": "pnpm check:changesets && pnpm --filter durable-harness build && pnpm --filter durable-harness check-dist && changeset publish",
    "ci:version": "pnpm check:changesets && changeset version",
    "cli-check": "pnpm --filter harness-world-cli-check cli-check",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@changesets/config": "^4.0.1",
    "@changesets/pre": "^3.0.0",
    "@changesets/read": "^1.0.1",
    "@manypkg/get-packages": "^3.1.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
