{
  "name": "durable-harness",
  "version": "0.0.1-beta.5",
  "description": "Durable coding-agent harnesses (Claude Code, Codex, OpenCode, Pi) on a Workflow SDK World: the session is a run, its event log the source of truth, and a crash resumes the turn from the log on another machine.",
  "license": "Apache-2.0",
  "homepage": "https://vercel.com/docs/agent-harnesses",
  "bugs": {
    "url": "https://github.com/vercel-labs/durable-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/durable-harness.git",
    "directory": "packages/durable-harness"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent",
    "agents",
    "ai",
    "harness",
    "durable",
    "durability",
    "workflow",
    "workflow-sdk",
    "world",
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "libfx",
    "nextjs",
    "vercel"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./claude-code": "./src/claude-code.ts",
    "./codex": "./src/codex.ts",
    "./opencode": "./src/opencode.ts",
    "./pi": "./src/pi.ts",
    "./pi-durable": "./src/pi-durable.ts",
    "./fx": "./src/fx.ts",
    "./sandbox": "./src/sandbox.ts",
    "./next": "./src/next.ts",
    "./vercel": "./src/vercel.ts",
    "./tools": "./src/tools.ts",
    "./package.json": "./package.json",
    "./instrumentation/otel": "./src/instrumentation/otel.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./claude-code": {
        "types": "./dist/claude-code.d.ts",
        "default": "./dist/claude-code.js"
      },
      "./codex": {
        "types": "./dist/codex.d.ts",
        "default": "./dist/codex.js"
      },
      "./opencode": {
        "types": "./dist/opencode.d.ts",
        "default": "./dist/opencode.js"
      },
      "./pi": {
        "types": "./dist/pi.d.ts",
        "default": "./dist/pi.js"
      },
      "./pi-durable": {
        "types": "./dist/pi-durable.d.ts",
        "default": "./dist/pi-durable.js"
      },
      "./fx": {
        "types": "./dist/fx.d.ts",
        "default": "./dist/fx.js"
      },
      "./sandbox": {
        "types": "./dist/sandbox.d.ts",
        "default": "./dist/sandbox.js"
      },
      "./next": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "./vercel": {
        "types": "./dist/vercel.d.ts",
        "default": "./dist/vercel.js"
      },
      "./tools": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "./package.json": "./package.json",
      "./instrumentation/otel": {
        "types": "./dist/instrumentation/otel.d.ts",
        "default": "./dist/instrumentation/otel.js"
      }
    },
    "bin": {
      "durable-harness": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/inline-tracing-types.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@vercel/oidc": "3.2.0",
    "@workflow/utils": "^5.0.2",
    "@workflow/world": "^5.0.4",
    "@workflow/world-local": "^5.1.1",
    "@workflow/world-vercel": "^5.2.1",
    "devalue": "^5.9.4",
    "typebox": "1.3.27",
    "ulid": "^3.0.1",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-agent-core": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4",
    "@opencode/client": "2.0.22",
    "@opencode/core": "2.0.22",
    "@opencode/schema": "2.0.22",
    "@opencode/server": "2.0.22",
    "@opentelemetry/otlp-transformer": ">=0.208.0 <1",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@vercel/agent-runs": "0.0.1",
    "@vercel/sandbox": "^3.7.0",
    "@workflow/world-postgres": "^5.0.4",
    "effect": "4.0.0-rc.112",
    "just-bash": "^3.4.2",
    "libfx": ">=0.0.13-dev.1432 <0.0.13 || >=0.0.14-0 <0.1.0",
    "next": ">=15.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@vercel/agent-runs": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "@opencode/core": {
      "optional": true
    },
    "@opencode/schema": {
      "optional": true
    },
    "@opencode/server": {
      "optional": true
    },
    "@workflow/world-postgres": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    },
    "just-bash": {
      "optional": true
    },
    "libfx": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "@opentelemetry/otlp-transformer": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@opencode/client": "2.0.22",
    "@opencode/core": "2.0.22",
    "@opencode/schema": "2.0.22",
    "@opencode/server": "2.0.22",
    "@opentelemetry/otlp-transformer": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@vercel/agent-runs": "0.0.1",
    "effect": "4.0.0-rc.112",
    "harness-world": "workspace:*",
    "harness-world-claude-code": "workspace:*",
    "harness-world-codex": "workspace:*",
    "harness-world-hands": "workspace:*",
    "harness-world-opencode": "workspace:*",
    "harness-world-pi": "workspace:*",
    "harness-world-process": "workspace:*",
    "harness-world-sandbox": "workspace:*",
    "just-bash": "3.4.2",
    "libfx": "catalog:",
    "next": "16.3.8",
    "pi-world": "workspace:*",
    "rollup": "4.63.5",
    "rollup-plugin-dts": "6.2.3",
    "tsup": "8.5.1",
    "zod": "4.5.4"
  }
}
