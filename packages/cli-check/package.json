{
  "name": "harness-world-cli-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drives a session of every harness on each World with scripted models, then inspects it with the stock Workflow CLI (`workflow inspect --json`) and checks what a user would see.",
  "scripts": {
    "test": "vitest run --dir src",
    "cli-check": "vitest run --dir test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@workflow/world": "catalog:",
    "ai": "catalog:",
    "durable-ai-sdk": "workspace:*",
    "harness-world": "workspace:*",
    "harness-world-claude-code": "workspace:*",
    "harness-world-codex": "workspace:*",
    "harness-world-fx": "workspace:*",
    "harness-world-hands": "workspace:*",
    "harness-world-opencode": "workspace:*",
    "harness-world-pi": "workspace:*",
    "harness-world-process": "workspace:*",
    "harness-world-sandbox": "workspace:*",
    "libfx": "catalog:",
    "pi-world": "workspace:*",
    "typebox": "1.3.27",
    "ulid": "^3.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@types/pg": "8.23.1",
    "@workflow/cli": "catalog:",
    "@workflow/world-local": "catalog:",
    "@workflow/world-postgres": "catalog:",
    "durable-harness": "workspace:*",
    "pg": "8.20.0"
  }
}
